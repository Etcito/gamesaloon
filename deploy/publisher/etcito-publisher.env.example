# Etcito publisher env (placeholders only). Install as the unit's EnvironmentFile, mode 640.
PUBLISHER_KEY=change-me
PUBLISHER_HOST=127.0.0.1
PUBLISHER_PORT=9997
PUBLISHER_DATA=/var/lib/etcito-publisher
PUBLISHER_HOME=/var/lib/etcito-publisher/home
WAVEDASH_BIN=wavedash
BUTLER_BIN=butler
OWNER_GAMES=my-game
PUBLISHER_GAMES=/var/lib/etcito-publisher/games.json
PUBLISHER_MAX_QUEUE=8
# JSON argv after the wavedash binary; {slug} and {name} are substituted. Empty = disabled (501).
# Placeholder argv: use the real create subcommand of your wavedash CLI. Single-quote the value (systemd strips "...").
PUBLISHER_WAVEDASH_CREATE_ARGS='["change-me","{slug}","{name}"]'
# Optional: mirror owner-game runs into the tenant. Leave empty to run alone.
ETCITO_URL=https://tenant.example.com
ETCITO_API_KEY=change-me
