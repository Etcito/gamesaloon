# /etc/kart-rooms.env: environment of the rooms server (systemd EnvironmentFile).

# Plain HTTP/WS port and address; TLS is terminated by Caddy or nginx.
PORT=8787
HOST=127.0.0.1

# Comma-separated STUN urls sent to clients.
STUN_URLS=stun:stun.l.google.com:19302

# Comma-separated TURN urls (coturn on this VM); used only with TURN_SECRET.
TURN_URLS=turn:rooms.example.com:3478?transport=udp,turn:rooms.example.com:3478?transport=tcp,turns:rooms.example.com:5349?transport=tcp

# Must equal static-auth-secret in turnserver.conf. Empty disables TURN.
TURN_SECRET=CHANGE_ME

# Capacity limits.
MAX_ROOMS=500
MAX_CLIENTS=2000

# Comma-separated allowed Origin values for /ws. Empty allows any origin.
ALLOWED_ORIGINS=https://game.example.com

# error, info or debug.
LOG_LEVEL=info

# Owner games: comma-separated game names exempt from the creator caps of multi-creator mode (docs/multi-game.md).
# Default empty: every game is a creator game.
#OWNER_GAMES=my-game,other-game

# Player store: memory (default, nothing persisted) or http (a remote table API, see docs/stores.md).
# One game = one gsk_ service key.
#PLAYER_STORE=http
#ETCITO_URL=https://tables.example.com
#ETCITO_GAME_KEYS={"<game>":"gsk_...","<other_game>":"gsk_..."}
# Multi-creator mode (docs/multi-game.md): the same JSON in a file, re-read every 30 s (replaces ETCITO_GAME_KEYS).
# Leave unset to keep the single-owner behaviour.
#ETCITO_GAME_KEYS_FILE=/etc/gamesaloon/game-keys.json
#ETCITO_CREATOR_MAX_ROOMS=10
#ETCITO_CREATOR_STORAGE_MAX_BYTES=52428800
