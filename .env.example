# Copy to .env. Every environment variable the code reads is listed here. Values shown are the
# defaults (except HOST, which the Docker image sets to 0.0.0.0). Lines starting with "#VAR=" are
# unset by default: remove the "#" to use them.
#
# Sources: src/config.ts (server), src/store/config.ts and src/store/games.ts (player store),
# src/publisher/main.ts (optional publisher process).

# ---------------------------------------------------------------- server (src/config.ts)

# TCP port.
PORT=8787
# Bind address. 127.0.0.1 = this machine only; 0.0.0.0 = all interfaces.
HOST=127.0.0.1
# Comma-separated STUN urls sent to clients.
STUN_URLS=stun:stun.l.google.com:19302
# Comma-separated TURN urls (optional, only used together with TURN_SECRET).
TURN_URLS=
# Shared secret with your coturn server (its static-auth-secret). Empty disables TURN.
TURN_SECRET=
# Capacity limits.
MAX_ROOMS=500
MAX_CLIENTS=2000
# Comma-separated allowed Origin values for /ws. Empty allows any origin.
ALLOWED_ORIGINS=
# error | info | debug
LOG_LEVEL=info

# Bot provider: no environment variable. It is configured per game in etc_settings (keys bots.enabled and
# bots.tokens, written from the administration interface); see docs/configuration.md, "Bot provider".

# Owner games: comma-separated game names exempt from the creator caps of multi-creator mode (docs/multi-game.md).
# Default empty: every game is a creator game.
#OWNER_GAMES=my-game,other-game

# ------------------------------------------- player store (src/store/config.ts, src/store/games.ts)

# memory (default, nothing persisted) or http (a remote table API, see docs/stores.md).
PLAYER_STORE=memory
# With PLAYER_STORE=http: base URL of the table service (http or https, no credentials in the URL).
#ETCITO_URL=https://tables.example.com
# With PLAYER_STORE=http: JSON object {"<game>":"gsk_..."}, one service key per game.
#ETCITO_GAME_KEYS={"mygame":"gsk_..."}
# Multi-creator mode (docs/multi-game.md): path of a file holding the same JSON, re-read every 30 s.
# Replaces ETCITO_GAME_KEYS.
#ETCITO_GAME_KEYS_FILE=/etc/gamesaloon/game-keys.json
# Multi-creator mode: room ceiling of a creator game.
#ETCITO_CREATOR_MAX_ROOMS=10
# Multi-creator mode: saves + player-content quota ceiling of a creator game, in bytes.
#ETCITO_CREATOR_STORAGE_MAX_BYTES=52428800

# ------------------- build publisher (optional separate process: npm run publisher, src/publisher/main.ts)
# Not needed to run a game server. Pushes game builds to Wavedash / itch.io; see docs/configuration.md.

# Listen address and port of the publisher's own HTTP API.
#PUBLISHER_HOST=127.0.0.1
#PUBLISHER_PORT=9997
# Bearer key of that API (at least 24 characters, required).
#PUBLISHER_KEY=
# Working directories (defaults shown) and the optional games map (JSON file, default <PUBLISHER_DATA>/games.json).
#PUBLISHER_DATA=/var/lib/etcito-publisher
#PUBLISHER_HOME=<PUBLISHER_DATA>/home
#PUBLISHER_GAMES=<PUBLISHER_DATA>/games.json
# Limits: largest uploaded build in bytes (default 157286400) and queued runs (default 8).
#PUBLISHER_MAX_BYTES=157286400
#PUBLISHER_MAX_QUEUE=8
# Command-line tools used to push builds.
#WAVEDASH_BIN=wavedash
#BUTLER_BIN=butler
# Optional: also record runs on the table service (needs both).
#ETCITO_API_KEY=
# Defaults shown: file holding the deployed git ref, and the health url checked after a self-update.
#HANDSHAKE_DEPLOYED_FILE=/opt/kart-rooms/.deployed-ref
#HANDSHAKE_HEALTH_URL=http://127.0.0.1:9998/health
# Set per request by the publisher for its child process; do not put real keys in a shared file.
#WAVEDASH_TOKEN=
#BUTLER_API_KEY=
