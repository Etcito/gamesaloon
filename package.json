{
  "name": "gamesaloon",
  "version": "0.1.0",
  "description": "GameSaloon: an open-source multiplayer rooms, relay and matchmaking server for web games.",
  "license": "AGPL-3.0-or-later",
  "author": "Etcito",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Etcito/gamesaloon.git"
  },
  "homepage": "https://github.com/Etcito/gamesaloon#readme",
  "bugs": {
    "url": "https://github.com/Etcito/gamesaloon/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/main.ts",
    "test": "node --experimental-strip-types --test \"test/**/*.test.ts\"",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "publisher": "node --experimental-strip-types src/publisher/main.ts"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/store/contract.d.ts",
      "import": "./dist/store/contract.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "ws": "8.18.3"
  }
}
